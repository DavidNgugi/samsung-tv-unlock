<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://tvunlock.local/peregrine"
        version="0.1.0"
        viewmodes="maximized">

  <!-- Package id becomes the app id the TV launcher uses: tvUnlock.Peregrine -->
  <tizen:application id="tvUnlock.Peregrine" package="tvUnlock" required_version="2.3"/>
  <content src="index.html"/>
  <feature name="http://tizen.org/feature/screen.size.all"/>

  <name>Peregrine</name>
  <description>Hello world, signed and installed over sdb.</description>

  <tizen:profile name="tv-samsung"/>

  <!-- No privileges: this build proves the signing and install path only. -->
  <tizen:setting screen-orientation="landscape"
                 context-menu="disable"
                 background-support="disable"
                 encryption="disable"
                 install-location="auto"
                 hwkey-event="enable"/>
</widget>
